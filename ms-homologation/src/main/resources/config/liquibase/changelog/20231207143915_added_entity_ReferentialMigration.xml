<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity ReferentialMigration.
    -->
    <changeSet id="20231207143915-1" author="jhipster">
        <createTable tableName="referential_migration">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="version_source_id" type="${uuidType}">
                <constraints nullable="true" />
            </column>
            <column name="version_cible_id" type="${uuidType}">
                <constraints nullable="true" />
            </column>
            <column name="etat" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="rapport" type="${clobType}">
                <constraints nullable="true" />
            </column>
            <column name="date_demande" type="${datetimeType}">
                <constraints nullable="true" />
            </column>
            <column name="decideur_id" type="${uuidType}">
                <constraints nullable="true" />
            </column>
            <column name="liaisons_retenues" type="${clobType}">
                <constraints nullable="true" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
        <dropDefaultValue tableName="referential_migration" columnName="date_demande" columnDataType="${datetimeType}"/>
    </changeSet>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->
</databaseChangeLog>
