<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity OperationInstance.
    -->
    <changeSet id="20231207142815-1" author="jhipster">
        <createTable tableName="operation_instance">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(40)">
                <constraints nullable="false" />
            </column>
            <column name="libelle" type="varchar(200)">
                <constraints nullable="true" />
            </column>
            <column name="segment" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="partie" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="service_code" type="varchar(40)">
                <constraints nullable="true" />
            </column>
            <column name="etat" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="degre_entrant" type="integer">
                <constraints nullable="false" />
            </column>
            <column name="echeance" type="date">
                <constraints nullable="true" />
            </column>
            <column name="date_etat" type="${datetimeType}">
                <constraints nullable="true" />
            </column>
            <column name="grille_reponses" type="${clobType}">
                <constraints nullable="true" />
            </column>
            <column name="liaison_id" type="${uuidType}">
                <constraints nullable="false" />
            </column>
            <column name="reference_operation_id" type="${uuidType}">
                <constraints nullable="false" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
        <dropDefaultValue tableName="operation_instance" columnName="date_etat" columnDataType="${datetimeType}"/>
    </changeSet>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->
</databaseChangeLog>
