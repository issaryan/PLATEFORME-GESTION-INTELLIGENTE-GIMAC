<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity Coverage.
    -->
    <changeSet id="20231207143415-1" author="jhipster">
        <createTable tableName="coverage">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="service_code" type="varchar(40)">
                <constraints nullable="false" />
            </column>
            <column name="nature" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="numerateur" type="integer">
                <constraints nullable="true" />
            </column>
            <column name="denominateur" type="integer">
                <constraints nullable="true" />
            </column>
            <column name="taux" type="decimal(21,2)">
                <constraints nullable="true" />
            </column>
            <column name="calculable" type="boolean">
                <constraints nullable="false" />
            </column>
            <column name="motif_non_calculable" type="varchar(200)">
                <constraints nullable="true" />
            </column>
            <column name="date_calcul" type="${datetimeType}">
                <constraints nullable="false" />
            </column>
            <column name="liaison_id" type="${uuidType}">
                <constraints nullable="false" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
        <dropDefaultValue tableName="coverage" columnName="date_calcul" columnDataType="${datetimeType}"/>
    </changeSet>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->
</databaseChangeLog>
