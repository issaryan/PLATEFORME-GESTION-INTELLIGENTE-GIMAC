<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity ReferenceOperation.
    -->
    <changeSet id="20231207142415-1" author="jhipster">
        <createTable tableName="reference_operation">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(40)">
                <constraints nullable="false" />
            </column>
            <column name="libelle" type="varchar(200)">
                <constraints nullable="false" />
            </column>
            <column name="phase" type="varchar(60)">
                <constraints nullable="false" />
            </column>
            <column name="segment" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="partie" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="service_code" type="varchar(40)">
                <constraints nullable="true" />
            </column>
            <column name="nature_couverture" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="preuve_attendue" type="${clobType}">
                <constraints nullable="true" />
            </column>
            <column name="id_scenario" type="varchar(80)">
                <constraints nullable="true" />
            </column>
            <column name="predecesseurs" type="${clobType}">
                <constraints nullable="true" />
            </column>
            <column name="fonction_responsable" type="varchar(60)">
                <constraints nullable="true" />
            </column>
            <column name="grille" type="${clobType}">
                <constraints nullable="true" />
            </column>
            <column name="version_id" type="${uuidType}">
                <constraints nullable="false" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
    </changeSet>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->
</databaseChangeLog>
