{
  "annotations": {
    "changelogDate": "20260928134317"
  },
  "applications": ["certification"],
  "clientRootFolder": "certification",
  "databaseType": "sql",
  "documentation": "Attestation de certification PDF/A-3 signée PAdES B-LTA avec la clé de cachet\\nde la plateforme, déposée en WORM dans MS-DOCUMENT (algorithme 6.38).",
  "dto": "mapstruct",
  "fields": [
    {
      "fieldName": "id",
      "fieldType": "UUID"
    },
    {
      "documentation": "Numéro d'attestation, par exemple ATT-CERT-2026-0009.",
      "fieldName": "attestationNumber",
      "fieldType": "String",
      "fieldValidateRules": ["required", "unique", "maxlength", "pattern"],
      "fieldValidateRulesMaxlength": "30",
      "fieldValidateRulesPattern": "^ATT-CERT-[0-9]{4}-[0-9]{4,}$"
    },
    {
      "documentation": "Pièce dans MS-DOCUMENT (référence, BNF-04).",
      "fieldName": "documentId",
      "fieldType": "UUID",
      "fieldValidateRules": ["required", "unique"]
    },
    {
      "fieldName": "pdfDigest",
      "fieldType": "String",
      "fieldValidateRules": ["required", "minlength", "maxlength", "pattern"],
      "fieldValidateRulesMaxlength": "64",
      "fieldValidateRulesMinlength": "64",
      "fieldValidateRulesPattern": "^[0-9a-f]{64}$"
    },
    {
      "documentation": "Niveau de signature, PAdES B-LTA.",
      "fieldName": "signatureLevel",
      "fieldType": "String",
      "fieldValidateRules": ["required", "maxlength"],
      "fieldValidateRulesMaxlength": "20"
    },
    {
      "documentation": "Pièces jointes embarquées : liste JSON (nom, type de média, relation, empreinte).",
      "fieldName": "attachments",
      "fieldType": "TextBlob",
      "fieldValidateRules": ["required"]
    },
    {
      "fieldName": "issuedAt",
      "fieldType": "Instant",
      "fieldValidateRules": ["required"]
    },
    {
      "documentation": "Confirmation reçue par document.document-sealed.v1 (condition C3).",
      "fieldName": "sealConfirmed",
      "fieldType": "Boolean",
      "fieldValidateRules": ["required"]
    }
  ],
  "microserviceName": "certification",
  "name": "CertificationAttestation",
  "readOnly": true,
  "relationships": [],
  "searchEngine": "no",
  "service": "serviceClass"
}
