<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity TimestampToken.
    -->
    <changeSet id="20231212200946-1" author="jhipster">
        <createTable tableName="timestamp_token">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="objet_type" type="varchar(20)">
                <constraints nullable="false" />
            </column>
            <column name="objet_id" type="${uuidType}">
                <constraints nullable="false" />
            </column>
            <column name="empreinte" type="varchar(64)">
                <constraints nullable="false" />
            </column>
            <column name="nonce" type="varchar(64)">
                <constraints nullable="false" />
            </column>
            <column name="jeton" type="${clobType}">
                <constraints nullable="false" />
            </column>
            <column name="date_jeton" type="${datetimeType}">
                <constraints nullable="false" />
            </column>
            <column name="verifie" type="boolean">
                <constraints nullable="false" />
            </column>
            <column name="autorite_chaine" type="varchar(500)">
                <constraints nullable="true" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
        <dropDefaultValue tableName="timestamp_token" columnName="date_jeton" columnDataType="${datetimeType}"/>
    </changeSet>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->
</databaseChangeLog>
