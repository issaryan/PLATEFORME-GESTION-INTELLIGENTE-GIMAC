<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity CompletenessCondition.
    -->
    <changeSet id="20231212200646-1" author="jhipster">
        <createTable tableName="completeness_condition">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="satisfaite" type="boolean">
                <constraints nullable="false" />
            </column>
            <column name="source" type="varchar(60)">
                <constraints nullable="true" />
            </column>
            <column name="detail" type="varchar(500)">
                <constraints nullable="true" />
            </column>
            <column name="date_verification" type="${datetimeType}">
                <constraints nullable="true" />
            </column>
            <column name="dossier_id" type="${uuidType}">
                <constraints nullable="false" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
        <dropDefaultValue tableName="completeness_condition" columnName="date_verification" columnDataType="${datetimeType}"/>
    </changeSet>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->
</databaseChangeLog>
