<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity GoLiveReport.
    -->
    <changeSet id="20231212200846-1" author="jhipster">
        <createTable tableName="go_live_report">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="document_ref" type="varchar(120)">
                <constraints nullable="false" />
            </column>
            <column name="empreinte" type="varchar(64)">
                <constraints nullable="false" />
            </column>
            <column name="heure_bascule" type="${datetimeType}">
                <constraints nullable="false" />
            </column>
            <column name="dans_fenetre" type="boolean">
                <constraints nullable="false" />
            </column>
            <column name="deposant_id" type="${uuidType}">
                <constraints nullable="true" />
            </column>
            <column name="date_depot" type="${datetimeType}">
                <constraints nullable="true" />
            </column>
            <column name="regularise" type="boolean">
                <constraints nullable="true" />
            </column>
            <column name="dossier_id" type="${uuidType}">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_go_live_report__dossier_id" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
        <dropDefaultValue tableName="go_live_report" columnName="heure_bascule" columnDataType="${datetimeType}"/>
        <dropDefaultValue tableName="go_live_report" columnName="date_depot" columnDataType="${datetimeType}"/>
    </changeSet>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->
</databaseChangeLog>
