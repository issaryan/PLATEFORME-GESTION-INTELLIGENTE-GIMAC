<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity ClosedOperationSnapshot.
    -->
    <changeSet id="20260928134617-1" author="jhipster">
        <createTable tableName="closed_operation_snapshot" remarks="Projection d&apos;une opération close, depuis homologation.operation-closed.v1 :\nelle entre dans le socle d&apos;évaluation β et permet d&apos;exclure des signataires\nles responsables d&apos;opérations (algorithme 6.35, étape 3). Écart CC corrigé :\nprojection décrite au CC §6.1.8.1 sans classe dédiée.">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="liaison_id" type="${uuidType}">
                <constraints nullable="false" />
            </column>
            <column name="operation_id" type="${uuidType}" remarks="Opération tenue par MS-HOMOLOGATION (référence, BNF-04).">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_closed_operation_snapshot__operation_id" />
            </column>
            <column name="operation_code" type="varchar(20)">
                <constraints nullable="false" />
            </column>
            <column name="reference_code" type="varchar(20)">
                <constraints nullable="false" />
            </column>
            <column name="service_code" type="varchar(80)">
                <constraints nullable="true" />
            </column>
            <column name="owner_id" type="${uuidType}">
                <constraints nullable="false" />
            </column>
            <column name="validator_id" type="${uuidType}">
                <constraints nullable="false" />
            </column>
            <column name="evidence_document_id" type="${uuidType}">
                <constraints nullable="false" />
            </column>
            <column name="evidence_digest" type="varchar(64)">
                <constraints nullable="false" />
            </column>
            <column name="closed_at" type="${datetimeType}">
                <constraints nullable="false" />
            </column>
            <column name="source_event_id" type="${uuidType}">
                <constraints nullable="false" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
        <dropDefaultValue tableName="closed_operation_snapshot" columnName="closed_at" columnDataType="${datetimeType}"/>
    </changeSet>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->

    <!--
        Load sample data generated with Faker.js
        - This data can be easily edited using a CSV editor (or even MS Excel) and
          is located in the 'src/main/resources/config/liquibase/fake-data' directory
        - By default this data is applied when running with the JHipster 'dev' profile.
          This can be customized by adding or removing 'faker' in the 'spring.liquibase.contexts'
          Spring Boot configuration key.
    -->
    <changeSet id="20260928134617-1-data" author="jhipster" context="faker">
        <loadData
                  file="config/liquibase/fake-data/closed_operation_snapshot.csv"
                  separator=";"
                  tableName="closed_operation_snapshot"
                  usePreparedStatements="true">
            <column name="id" type="${uuidType}"/>
            <column name="liaison_id" type="${uuidType}"/>
            <column name="operation_id" type="${uuidType}"/>
            <column name="operation_code" type="string"/>
            <column name="reference_code" type="string"/>
            <column name="service_code" type="string"/>
            <column name="owner_id" type="${uuidType}"/>
            <column name="validator_id" type="${uuidType}"/>
            <column name="evidence_document_id" type="${uuidType}"/>
            <column name="evidence_digest" type="string"/>
            <column name="closed_at" type="date"/>
            <column name="source_event_id" type="${uuidType}"/>
            <!-- jhipster-needle-liquibase-add-loadcolumn - JHipster (and/or extensions) can add load columns here -->
        </loadData>
    </changeSet>
</databaseChangeLog>
