{
  "annotations": {
    "changelogDate": "20231222194934"
  },
  "applications": ["gateway"],
  "databaseType": "sql",
  "documentation": "Couche de présentation connue de la passerelle (CC §6.1.1.3).\\nTrois enregistrements attendus : département, portail, console.",
  "dto": "mapstruct",
  "fields": [
    {
      "documentation": "Code unique de la couche : DEPARTEMENT, PORTAIL ou CONSOLE.",
      "fieldName": "name",
      "fieldType": "String",
      "fieldValidateRules": ["required", "unique", "maxlength"],
      "fieldValidateRulesMaxlength": "50"
    },
    {
      "fieldName": "zone",
      "fieldType": "NetworkZone",
      "fieldTypeDocumentation": "Zone réseau d'origine d'une requête (REC D-24), et non zone de déploiement.",
      "fieldValidateRules": ["required"],
      "fieldValues": "DEPARTEMENT,DMZ,ADMINISTRATION"
    },
    {
      "documentation": "Exigence d'authentification, par exemple \"OIDC+FIDO2+mTLS\".",
      "fieldName": "authenticationRequirement",
      "fieldType": "String",
      "fieldValidateRules": ["required", "maxlength"],
      "fieldValidateRulesMaxlength": "255"
    },
    {
      "documentation": "Préfixe des routes BFF de la couche, par exemple /bff/des.",
      "fieldName": "bffPrefix",
      "fieldType": "String",
      "fieldValidateRules": ["required", "unique", "maxlength", "pattern"],
      "fieldValidateRulesMaxlength": "100",
      "fieldValidateRulesPattern": "^\\/[a-z0-9\\/-]*$"
    },
    {
      "documentation": "Quota par défaut en requêtes par minute : 500, 100 ou 1000 (algorithme 6.1).",
      "fieldName": "defaultRateLimitPerMinute",
      "fieldType": "Integer",
      "fieldValidateRules": ["required", "min"],
      "fieldValidateRulesMin": "1"
    }
  ],
  "name": "PresentationLayer",
  "relationships": [],
  "searchEngine": "no",
  "service": "serviceClass"
}
