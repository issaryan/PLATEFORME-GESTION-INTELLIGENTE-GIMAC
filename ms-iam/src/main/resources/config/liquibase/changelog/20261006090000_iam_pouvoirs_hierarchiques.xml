    <changeSet id="iam-demande-administration" author="lot1">
        <createTable tableName="demande_administration">
            <column name="id" type="uuid"><constraints primaryKey="true" nullable="false" primaryKeyName="pk_demande_administration"/></column>
            <column name="type" type="varchar(20)"><constraints nullable="false"/></column>
            <column name="demandeur_id" type="varchar(36)"><constraints nullable="false"/></column>
            <column name="demandeur_nom" type="varchar(255)"/>
            <column name="cible_id" type="varchar(36)"/>
            <column name="cible_nom" type="varchar(255)"/>
            <column name="cle_cible" type="varchar(120)"><constraints nullable="false"/></column>
            <column name="contenu" type="varchar(4000)"><constraints nullable="false"/></column>
            <column name="motif" type="varchar(500)"><constraints nullable="false"/></column>
            <column name="etat" type="varchar(12)"><constraints nullable="false"/></column>
            <column name="decision_par_id" type="varchar(36)"/>
            <column name="decision_par_nom" type="varchar(255)"/>
            <column name="decision_motif" type="varchar(500)"/>
            <column name="decision_le" type="timestamptz"/>
            <column name="creee_le" type="timestamptz"><constraints nullable="false"/></column>
            <column name="version" type="bigint" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>
        <sql>ALTER TABLE demande_administration ADD CONSTRAINT ck_demande_administration_type CHECK (type IN ('CREATION_COMPTE', 'PROFILS', 'STATUT'));</sql>
        <sql>ALTER TABLE demande_administration ADD CONSTRAINT ck_demande_administration_etat CHECK (etat IN ('EN_ATTENTE', 'ACCEPTEE', 'REFUSEE', 'ANNULEE'));</sql>
        <!-- Une seule demande en attente par cible et par type (409 ORG_DEMANDE_EXISTANTE). -->
        <sql>CREATE UNIQUE INDEX ux_demande_administration_en_attente ON demande_administration (type, cle_cible) WHERE etat = 'EN_ATTENTE';</sql>
        <createIndex tableName="demande_administration" indexName="ix_demande_administration_demandeur">
            <column name="demandeur_id"/>
            <column name="creee_le"/>
        </createIndex>
        <createIndex tableName="demande_administration" indexName="ix_demande_administration_etat">
            <column name="etat"/>
            <column name="creee_le"/>
        </createIndex>
    </changeSet>

    <changeSet id="iam-profil-cree" author="lot1">
        <createTable tableName="profil_cree">
            <column name="code" type="varchar(60)"><constraints primaryKey="true" nullable="false" primaryKeyName="pk_profil_cree"/></column>
            <column name="description" type="varchar(255)"><constraints nullable="false"/></column>
            <column name="privilegie" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="cree_par" type="varchar(100)"><constraints nullable="false"/></column>
            <column name="cree_le" type="timestamptz"><constraints nullable="false"/></column>
        </createTable>
        <sql>ALTER TABLE profil_cree ADD CONSTRAINT ck_profil_cree_code CHECK (code ~ '^ROLE_[A-Z][A-Z0-9_]{2,40}$');</sql>
    </changeSet>
</databaseChangeLog>
