<?xml version="1.0" encoding="utf-8"?>
<!-- MS-IAM : pouvoirs des chefs sur leurs subordonnés (D-81, docs/lot1/pouvoirs-hierarchiques.md) :
     responsable d'une unité (§2), matrice des pouvoirs et profils demandables (§3), demandes à
     l'administration (§4), profils créés par l'administration (§5). -->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="iam-unite-responsable" author="lot1">
        <addColumn tableName="unite_organisationnelle">
            <column name="responsable_id" type="varchar(36)"/>
        </addColumn>
        <createIndex tableName="unite_organisationnelle" indexName="ix_unite_organisationnelle_responsable">
            <column name="responsable_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="iam-matrice-pouvoirs" author="lot1">
        <!-- Portée d'une action pour un profil ; une portée absente vaut AUCUNE. -->
        <createTable tableName="pouvoir_profil">
            <column name="profil" type="varchar(60)"><constraints nullable="false"/></column>
            <column name="action" type="varchar(40)"><constraints nullable="false"/></column>
            <column name="portee" type="varchar(10)"><constraints nullable="false"/></column>
        </createTable>
        <addPrimaryKey tableName="pouvoir_profil" columnNames="profil, action" constraintName="pk_pouvoir_profil"/>
        <sql>ALTER TABLE pouvoir_profil ADD CONSTRAINT ck_pouvoir_profil_action CHECK (action IN ('TACHE_CONFIER', 'TACHE_SUIVRE', 'ACTIVITE_LIRE', 'RAPPORT_VISER', 'RATTACHEMENT_MODIFIER', 'COMPTE_DEMANDER', 'PROFIL_DEMANDER', 'STATUT_DEMANDER'));</sql>
        <sql>ALTER TABLE pouvoir_profil ADD CONSTRAINT ck_pouvoir_profil_portee CHECK (portee IN ('AUCUNE', 'DIRECTS', 'EQUIPE', 'UNITES'));</sql>
        <!-- Profils qu'un titulaire du profil peut demander pour un subordonné (jamais un profil privilégié). -->
        <createTable tableName="profil_demandable">
            <column name="profil" type="varchar(60)"><constraints nullable="false"/></column>
            <column name="profil_demandable" type="varchar(60)"><constraints nullable="false"/></column>
        </createTable>
        <addPrimaryKey tableName="profil_demandable" columnNames="profil, profil_demandable" constraintName="pk_profil_demandable"/>
    </changeSet>

