<?xml version="1.0" encoding="utf-8"?>
<!-- MS-IAM : administration déléguée de la Sandbox GIMAC (D-115, docs/lot1/sandbox-existant-adapte.md §4, US-EXI-03) :
     étapes de saga déjà appliquées, rejouables par leur clé d'idempotence sans double effet. Ensemble idempotent. -->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="iam-etape-idempotente" author="lot1">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="etape_idempotente"/></not>
        </preConditions>
        <createTable tableName="etape_idempotente">
            <column name="cle" type="varchar(100)"><constraints nullable="false"/></column>
            <column name="operation" type="varchar(60)"><constraints nullable="false"/></column>
            <column name="resultat" type="varchar(255)"><constraints nullable="false"/></column>
            <column name="acteur_id" type="varchar(100)"><constraints nullable="false"/></column>
            <column name="cree_le" type="timestamptz"><constraints nullable="false"/></column>
        </createTable>
        <addPrimaryKey tableName="etape_idempotente" columnNames="cle, operation" constraintName="pk_etape_idempotente"/>
    </changeSet>
</databaseChangeLog>
