<?xml version="1.0" encoding="utf-8"?>
<!-- Notifications du monitoring et des astreintes (D-116, docs/lot1/astreintes-monitoring.md §10) : type MONITORING
     (sujet monitoring.notification : rapport reçu, rapport quotidien de 8 h attendu ou en retard) et préférence
     correspondante (active par défaut). -->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="not-notifications-monitoring" author="lot1">
        <sql>ALTER TABLE notification_utilisateur DROP CONSTRAINT ck_notification_utilisateur_type;</sql>
        <sql>ALTER TABLE notification_utilisateur ADD CONSTRAINT ck_notification_utilisateur_type CHECK (type IN ('MESSAGE', 'TACHE', 'RAPPORT', 'DEMANDE', 'MENTION', 'REPONSE', 'PROCESSUS', 'HOMOLOGATION', 'MONITORING'));</sql>
        <addColumn tableName="preference_notification">
            <column name="type_monitoring" type="boolean" defaultValueBoolean="true"><constraints nullable="false"/></column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
