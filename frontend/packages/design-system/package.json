{
  "name": "@gimac/design-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Système de conception GIMAC DES (DS-GIMAC-01 v1.0) : jetons, styles et composants React",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./tokens.json": "./src/jetons/tokens.json",
    "./assets/*": "./src/assets/*",
    "./reset.css": "./src/reset.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "jetons": "node scripts/generer-jetons.mjs",
    "controle-jetons": "node scripts/check-tokens.mjs && node scripts/generer-jetons.mjs --verifier",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json && npm run controle-jetons",
    "couverture": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/ubuntu": "5.3.0",
    "pdfjs-dist": "6.3.289",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "30.1.1",
    "typescript": "~6.0.2",
    "vitest": "5.0.2"
  }
}
