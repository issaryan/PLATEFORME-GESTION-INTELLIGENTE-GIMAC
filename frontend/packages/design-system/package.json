{
  "name": "@gimac/design-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Système de conception GIMAC DES (DS-GIMAC-01 v1.0) : jetons, styles et composants React",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./tokens.json": "./src/jetons/tokens.json",
    "./assets/*": "./src/assets/*"
  },
  "sideEffects": ["*.css"],
  "scripts": {
    "jetons": "node scripts/generer-jetons.mjs",
    "lint": "tsc --noEmit -p tsconfig.json && node scripts/generer-jetons.mjs --verifier"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/ubuntu": "5.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "~6.0.2"
  }
}
