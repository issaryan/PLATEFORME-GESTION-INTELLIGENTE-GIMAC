{
  "name": "@gimac/frontend",
  "private": true,
  "description": "Couches de présentation de la plateforme DES du GIMAC (D-46, D-51)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:departement": "npm run dev -w @gimac/app-departement",
    "dev:portail": "npm run dev -w @gimac/app-portail",
    "dev:console": "npm run dev -w @gimac/app-console",
    "dev:catalogue": "npm run dev -w @gimac/app-catalogue",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
