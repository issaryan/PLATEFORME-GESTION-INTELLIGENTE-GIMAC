# Service d'une couche de présentation. Seules ${GIMAC_PASSERELLE} et ${GIMAC_RESOLVEUR}
# sont substituées au démarrage par l'image nginx ; les autres variables sont celles de nginx.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # Résolution différée de la passerelle : la couche démarre même si MS-GATEWAY est absente.
    resolver ${GIMAC_RESOLVEUR} valid=30s ipv6=off;
    set $passerelle ${GIMAC_PASSERELLE};

    include /etc/nginx/gimac-securite.conf;

    # Sonde de santé pour Docker et Kubernetes.
    location = /sante {
        access_log off;
        default_type text/plain;
        return 200 "UP\n";
    }

    # Modèle BFF : la session est portée par MS-GATEWAY ; le navigateur ne voit aucun jeton.
    # /bff porte les routes des couches (PI-GIMAC-01 §0.6), y compris le canal poussé (flux SSE).
    location ~ ^/(api|bff|oauth2|login|logout)(/|$) {
        proxy_pass $passerelle;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    # Fichiers versionnés par Vite : cache long.
    location /assets/ {
        include /etc/nginx/gimac-securite.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Application monopage : toute route inconnue rend index.html, jamais mis en cache.
    location / {
        include /etc/nginx/gimac-securite.conf;
        add_header Cache-Control "no-store" always;
        try_files $uri /index.html;
    }
}
