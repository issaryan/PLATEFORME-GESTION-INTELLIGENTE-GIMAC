# Service d'une couche de présentation. ${GIMAC_PASSERELLE} et ${GIMAC_RESOLVEUR} sont
# substituées au démarrage ; les autres variables sont celles de nginx. La variable de
# proxy_pass impose une résolution DNS à chaque connexion après expiration du cache.
# Protocole d'origine (D-75) : derrière le relais HTTPS du serveur (nginx de l'hôte), celui qu'il
# transmet, pour que la passerelle pose ses témoins Secure et forme ses adresses en https ; à défaut,
# celui de la requête reçue.
map $http_x_forwarded_proto $proto_origine {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 8080;
    server_name _;
    resolver ${GIMAC_RESOLVEUR} valid=10s;
    set $passerelle ${GIMAC_PASSERELLE};
    root /usr/share/nginx/html;
    server_tokens off;

    include /etc/nginx/gimac-securite.conf;

    # Sonde de santé pour Docker et Kubernetes.
    location = /sante {
        access_log off;
        default_type text/plain;
        return 200 "UP\n";
    }

    # Flux temps réel (Server-Sent Events) : supervision de la plateforme (/api/plateforme/flux, console)
    # et canal poussé des couches (/bff/<couche>/live). Aucune mise en tampon ni en cache, HTTP/1.1
    # persistant, connexion longue : chaque événement est remis dès son émission par la passerelle.
    location = /api/plateforme/flux {
        proxy_pass $passerelle;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $proto_origine;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 24h;
        proxy_send_timeout 24h;
    }
    location ~ ^/bff/(des|portail|console)/live$ {
        proxy_pass $passerelle;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $proto_origine;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 24h;
        proxy_send_timeout 24h;
    }

    # Modèle BFF : la session est portée par MS-GATEWAY ; le navigateur ne voit aucun jeton. Connexion sur la
    # plateforme (D-65) : /api/connexion ; plus de redirection vers le fournisseur d'identité (/oauth2, /login).
    # /bff porte les routes des couches (PI-GIMAC-01 §0.6), y compris le canal poussé (flux SSE).
    location ~ ^/(api|bff|logout)(/|$) {
        # Corps des requêtes (D-73) : nginx refuse au-delà de 1 Mo par défaut (413). La borne utile est celle
        # des services (messagerie : 5 pièces de 20 Mo ; documents : 20 Mo ; photo de profil : 3 Mo) ;
        # 110 Mo couvre la plus large, et le corps est transmis au fil de l'eau, sans tampon disque.
        client_max_body_size 110m;
        proxy_request_buffering off;
        proxy_pass $passerelle;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $proto_origine;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    # Fichiers versionnés par Vite : cache long.
    location /assets/ {
        include /etc/nginx/gimac-securite.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
        # Modules ECMAScript (.mjs, dont le worker de pdf.js, D-73) : absents du mime.types de nginx,
        # ils partiraient en application/octet-stream, que le navigateur refuse de charger en module.
        location ~ \.mjs$ {
            types { text/javascript mjs; }
            try_files $uri =404;
        }
    }

    # Application monopage : toute route inconnue rend index.html, jamais mis en cache.
    location / {
        include /etc/nginx/gimac-securite.conf;
        add_header Cache-Control "no-store" always;
        try_files $uri /index.html;
    }
}
