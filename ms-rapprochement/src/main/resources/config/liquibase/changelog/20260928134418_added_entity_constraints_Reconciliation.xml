        <addForeignKeyConstraint baseColumnNames="settlement_statement_id"
                                 baseTableName="reconciliation"
                                 constraintName="fk_reconciliation__settlement_statement_id"
                                 referencedColumnNames="id"
                                 referencedTableName="imported_statement"
                                 />
    </changeSet>
</databaseChangeLog>
