      "fieldValidateRules": ["required"],
      "fieldValues": "S1,S2,S3,S4"
    },
    {
      "documentation": "Incident de sécurité : ajoute le RSSI au niveau N3 d'escalade.",
      "fieldName": "securityIncident",
      "fieldType": "Boolean",
      "fieldValidateRules": ["required"]
    },
    {
      "fieldName": "dataCompromiseSuspected",
      "fieldType": "Boolean"
    },
    {
