      "fieldName": "regulatoryFlag",
      "fieldType": "Boolean",
      "fieldValidateRules": ["required"]
    },
    {
      "fieldName": "qualifiedAt",
      "fieldType": "Instant",
      "fieldValidateRules": ["required"]
    },
    {
      "fieldName": "qualifiedBy",
      "fieldType": "UUID",
      "fieldValidateRules": ["required"]
    },
    {
