      "fieldName": "rootCauseProofRef",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "100"
    },
    {
      "documentation": "Critère 2 : plan de remédiation ; les actions sont dans RemediationAction.",
      "fieldName": "remediationPlan",
      "fieldType": "TextBlob"
    },
    {
      "documentation": "Critère 3 : test de résolution prouvé, postérieur à la résolution.",
      "fieldName": "resolutionTest",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "4000"
    },
    {
      "fieldName": "resolutionTestPassed",
      "fieldType": "Boolean"
    },
    {
      "fieldName": "resolutionTestAuthorId",
      "fieldType": "UUID"
    },
    {
      "fieldName": "resolutionTestAt",
      "fieldType": "Instant"
    },
    {
      "fieldName": "resolutionTestProofRef",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "100"
    },
    {
      "documentation": "Critère 4 : capitalisation (retour d'expérience), exigée pour S1 et S2.",
      "fieldName": "lessonsLearnedRef",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "100"
    },
    {
      "documentation": "Mention « sans objet » justifiée, admise pour S3 et S4 seulement.",
      "fieldName": "lessonsLearnedWaiver",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "1000"
    },
    {
      "documentation": "Rapport circonstancié : exigible au plus tard 5 min après la résolution pour S1 et S2 (D-10).",
      "fieldName": "reportDueAt",
      "fieldType": "Instant"
    },
    {
      "fieldName": "reportGeneratedAt",
      "fieldType": "Instant"
    },
    {
