      "fieldName": "reportRef",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "100"
    },
    {
      "fieldName": "reportDigest",
      "fieldType": "String",
      "fieldValidateRules": ["minlength", "maxlength", "pattern"],
      "fieldValidateRulesMaxlength": "64",
      "fieldValidateRulesMinlength": "64",
      "fieldValidateRulesPattern": "^[0-9a-f]{64}$"
    },
    {
      "documentation": "Visa du responsable conformité, exigé si le marqueur est positionné.",
      "fieldName": "complianceVisaBy",
      "fieldType": "UUID"
    },
    {
      "fieldName": "complianceVisaAt",
      "fieldType": "Instant"
    },
    {
      "documentation": "Validation des quatre critères : fin de mesure du MTTR (D-09).",
      "fieldName": "criteriaValidatedAt",
      "fieldType": "Instant"
    },
    {
      "fieldName": "validatorId",
      "fieldType": "UUID"
    },
    {
      "documentation": "Durée brute, de l'ouverture à la résolution, toujours publiée.",
      "fieldName": "rawDuration",
      "fieldType": "Duration"
    },
    {
      "documentation": "Somme des gels d'attente de tiers.",
      "fieldName": "frozenDuration",
      "fieldType": "Duration"
    },
    {
      "documentation": "Délai imputable (durée brute moins les gels), gelé à la clôture (D-09).",
      "fieldName": "imputableDelay",
      "fieldType": "Duration"
    },
    {
      "documentation": "MTTR réel : de l'ouverture à la validation des critères, sans déduire les gels (D-09).",
      "fieldName": "mttr",
      "fieldType": "Duration"
    },
    {
      "fieldName": "takeChargeMet",
      "fieldType": "Boolean"
    },
    {
      "fieldName": "restorationMet",
      "fieldType": "Boolean"
    }
  ],
  "jpaMetamodelFiltering": true,
