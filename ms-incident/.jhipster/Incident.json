  "applications": ["incident"],
  "clientRootFolder": "incident",
  "databaseType": "sql",
  "documentation": "Incident : qualification d'un ticket de type INCIDENT (matrice 5×5),\\ncritères de clôture (D-09) et rapport circonstancié (D-10).",
  "dto": "mapstruct",
  "fields": [
    {
      "fieldName": "id",
      "fieldType": "UUID"
    },
    {
      "fieldName": "impact",
      "fieldType": "Integer",
      "fieldValidateRules": ["required", "min", "max"],
      "fieldValidateRulesMax": "5",
      "fieldValidateRulesMin": "1"
    },
    {
      "fieldName": "urgency",
      "fieldType": "Integer",
      "fieldValidateRules": ["required", "min", "max"],
      "fieldValidateRulesMax": "5",
      "fieldValidateRulesMin": "1"
    },
    {
      "documentation": "Score impact × urgence.",
      "fieldName": "score",
      "fieldType": "Integer",
      "fieldValidateRules": ["required", "min", "max"],
      "fieldValidateRulesMax": "25",
      "fieldValidateRulesMin": "1"
    },
    {
      "fieldName": "severity",
      "fieldType": "Severity",
