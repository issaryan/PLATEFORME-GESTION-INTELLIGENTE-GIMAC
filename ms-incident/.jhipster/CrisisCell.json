      "documentation": "Une seule cellule active par incident.",
      "otherEntityName": "incident",
      "relationshipName": "incident",
      "relationshipSide": "left",
      "relationshipType": "many-to-one",
      "relationshipValidateRules": "required"
    }
  ],
  "searchEngine": "no",
