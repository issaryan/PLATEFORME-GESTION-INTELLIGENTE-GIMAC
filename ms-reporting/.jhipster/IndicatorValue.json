  "applications": ["reporting"],
  "clientRootFolder": "reporting",
  "databaseType": "sql",
  "documentation": "Valeur calculée d'un indicateur pour une période et une clé de dimension,\\nhistorisée (IndicatorRepositoryPort.series). Les cockpits lisent la\\ndernière valeur matérialisée.",
  "dto": "mapstruct",
