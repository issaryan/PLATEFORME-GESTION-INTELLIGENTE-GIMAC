{
  "annotations": {
    "changelogDate": "20260929150121"
  },
  "applications": ["participant"],
  "clientRootFolder": "participant",
  "databaseType": "sql",
  "documentation": "Fiche institutionnelle (BF-07). Le statut ne change que par une\\ntransition approuvée (StatusTransition) ; aucune donnée de routage.",
  "dto": "mapstruct",
  "fields": [
    {
      "fieldName": "id",
      "fieldType": "UUID"
    },
    {
      "fieldName": "name",
      "fieldType": "String",
      "fieldValidateRules": ["required", "maxlength"],
      "fieldValidateRulesMaxlength": "255"
    },
    {
      "fieldName": "acronym",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "50"
    },
    {
      "documentation": "Code participant GIMAC, par exemple EP-A-017 ; attribué au prononcé de l'adhésion (D-57).",
      "fieldName": "participantCode",
      "fieldType": "String",
      "fieldValidateRules": ["unique", "maxlength", "pattern"],
      "fieldValidateRulesMaxlength": "20",
      "fieldValidateRulesPattern": "^[A-Z0-9-]+$"
    },
    {
      "documentation": "Code d'identification ISO 9362 (BIC), s'il existe (BF-07).",
      "fieldName": "identificationCode",
      "fieldType": "String",
      "fieldValidateRules": ["unique", "maxlength", "pattern"],
      "fieldValidateRulesMaxlength": "11",
      "fieldValidateRulesPattern": "^[A-Z]{4}[A-Z]{2}[A-Z0-9]{2}([A-Z0-9]{3})?$"
    },
    {
      "documentation": "Code banque BEAC, unique (RG-10).",
      "fieldName": "beacBankCode",
      "fieldType": "String",
      "fieldValidateRules": ["unique", "maxlength", "pattern"],
      "fieldValidateRulesMaxlength": "10",
      "fieldValidateRulesPattern": "^[A-Z0-9]+$"
    },
    {
      "documentation": "Pays CEMAC, code ISO 3166-1 alpha-2.",
      "fieldName": "country",
      "fieldType": "String",
      "fieldValidateRules": ["required", "maxlength", "pattern"],
      "fieldValidateRulesMaxlength": "2",
      "fieldValidateRulesPattern": "^(CM|CF|CG|GA|GQ|TD)$"
    },
    {
      "fieldName": "category",
      "fieldType": "InstitutionCategory",
      "fieldTypeDocumentation": "Catégories d'établissement (PAR-01, CA §3.4.2).",
      "fieldValidateRules": ["required"],
      "fieldValues": "BANQUE,MICROFINANCE,ETABLISSEMENT_PAIEMENT,EMETTEUR_MONNAIE_ELECTRONIQUE,TRESOR_PUBLIC,AGREGATEUR,FINTECH,EDITEUR_LOGICIEL"
    },
    {
      "documentation": "Mode d'adhésion ; exigé au prononcé de l'adhésion, inconnu à la prise de contact.",
      "fieldName": "membershipMode",
      "fieldType": "MembershipMode",
      "fieldTypeDocumentation": "Mode d'adhésion : direct (compte de règlement BEAC) ou indirect (banque marraine).",
      "fieldValues": "DIRECT,INDIRECT"
    },
    {
      "documentation": "Référence du compte de règlement à la BEAC, obligatoire en adhésion directe (RG-11).",
      "fieldName": "settlementAccountRef",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "50"
    },
    {
      "documentation": "Référence du compte de cantonnement, en adhésion indirecte (RG-12).",
      "fieldName": "ringFencedAccountRef",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "50"
    },
    {
      "fieldName": "joinedOn",
      "fieldType": "LocalDate"
    },
    {
      "fieldName": "status",
      "fieldType": "InstitutionStatus",
      "fieldTypeDocumentation": "Cycle de vie de l'institution (D-08 complété par D-57) : CANDIDAT (« Prospect »\\ndu CR, prise de contact), ADHERENT (dossier d'adhésion complet, adhésion prononcée\\npar la DDRM), EN_HOMOLOGATION (première liaison ouverte), ... ; CLOS_SANS_SUITE\\ndepuis CANDIDAT ou ADHERENT, avec motif.",
      "fieldValidateRules": ["required"],
      "fieldValues": "CANDIDAT,ADHERENT,EN_HOMOLOGATION,ACTIF,A_REGULARISER,SUSPENDU,RETIRE,CLOS_SANS_SUITE"
    },
    {
      "fieldName": "complianceState",
      "fieldType": "ComplianceState",
      "fieldTypeDocumentation": "État de conformité documentaire (algorithme 6.27).",
      "fieldValidateRules": ["required"],
      "fieldValues": "CONFORME,A_REGULARISER,NON_CONFORME"
    },
    {
      "documentation": "Réception de certification.attestation-issued.v1 (prérequis de ACTIF).",
      "fieldName": "attestationIssuedAt",
      "fieldType": "Instant"
    },
    {
      "documentation": "Réception de certification.go-live-authorized.v1 (RG-13).",
      "fieldName": "goLiveAuthorizedAt",
      "fieldType": "Instant"
    },
    {
      "documentation": "Liaisons ouvertes dans MS-HOMOLOGATION, connues par événement (prérequis de RETIRE).",
      "fieldName": "openLinkCount",
      "fieldType": "Integer",
      "fieldValidateRules": ["required", "min"],
      "fieldValidateRulesMin": "0"
    },
    {
      "documentation": "Suspens ouverts dans MS-RAPPROCHEMENT, connus par événement (prérequis de RETIRE).",
      "fieldName": "openSuspenseCount",
      "fieldType": "Integer",
      "fieldValidateRules": ["required", "min"],
      "fieldValidateRulesMin": "0"
    },
    {
      "fieldName": "createdAt",
      "fieldType": "Instant",
      "fieldValidateRules": ["required"]
    },
    {
      "documentation": "Date de la prise de contact (rang 1).",
      "fieldName": "contactedOn",
      "fieldType": "LocalDate"
    },
    {
      "documentation": "Origine de la prise de contact : courrier, réunion, salon, recommandation...",
      "fieldName": "contactOrigin",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "255"
    },
    {
      "documentation": "Projet envisagé par le candidat, tel qu'exprimé à la prise de contact.",
      "fieldName": "intendedProject",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "1000"
    },
    {
      "documentation": "Chargé de la DDRM qui porte le dossier.",
      "fieldName": "ddrmOfficerId",
      "fieldType": "UUID"
    },
    {
      "fieldName": "ddrmOfficerName",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "200"
    },
    {
      "documentation": "Prononcé de l'adhésion (rang 2) : date et auteur.",
      "fieldName": "admittedAt",
      "fieldType": "Instant"
    },
    {
      "fieldName": "admittedById",
      "fieldType": "UUID"
    },
    {
      "documentation": "Clôture sans suite : motif et date.",
      "fieldName": "closureReason",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "500"
    },
    {
      "fieldName": "closedAt",
      "fieldType": "Instant"
    }
  ],
  "jpaMetamodelFiltering": true,
  "microserviceName": "participant",
  "name": "Institution",
  "pagination": "pagination",
  "relationships": [
    {
      "documentation": "Banque de règlement et banque marraine : institutions du même registre.",
      "otherEntityField": "participantCode",
      "otherEntityName": "institution",
      "relationshipName": "settlementBank",
      "relationshipSide": "left",
      "relationshipType": "many-to-one"
    },
    {
      "otherEntityField": "participantCode",
      "otherEntityName": "institution",
      "relationshipName": "sponsorBank",
      "relationshipSide": "left",
      "relationshipType": "many-to-one"
    }
  ],
  "searchEngine": "no",
  "service": "serviceClass"
}
