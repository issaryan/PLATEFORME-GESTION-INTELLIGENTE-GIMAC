      "relationshipType": "one-to-one",
      "relationshipValidateRules": "required"
    },
    {
      "documentation": "Nouvelle version d'un rapport scellé, remplaçant la précédente.",
      "otherEntityField": "reference",
      "otherEntityName": "shiftReport",
      "relationshipName": "supersedes",
      "relationshipSide": "left",
      "relationshipType": "one-to-one"
    }
  ],
