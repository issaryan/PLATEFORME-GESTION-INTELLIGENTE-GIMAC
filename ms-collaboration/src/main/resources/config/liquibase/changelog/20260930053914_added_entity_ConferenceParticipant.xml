<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity ConferenceParticipant.
    -->
    <changeSet id="20260930053914-1" author="jhipster">
        <createTable tableName="conference_participant" remarks="Entrée et sortie d&apos;un participant. Écart CC corrigé : l&apos;attribut\nparticipants (List&lt;UUID&gt;) du CC est normalisé pour la chronologie de l&apos;archive.">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="${uuidType}" remarks="Participant (MS-IAM).">
                <constraints nullable="false" />
            </column>
            <column name="terminal_id" type="varchar(100)">
                <constraints nullable="false" />
            </column>
            <column name="joined_at" type="${datetimeType}">
                <constraints nullable="false" />
            </column>
            <column name="left_at" type="${datetimeType}">
                <constraints nullable="true" />
            </column>
            <column name="conference_id" type="${uuidType}">
                <constraints nullable="false" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
        <dropDefaultValue tableName="conference_participant" columnName="joined_at" columnDataType="${datetimeType}"/>
        <dropDefaultValue tableName="conference_participant" columnName="left_at" columnDataType="${datetimeType}"/>
    </changeSet>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->
</databaseChangeLog>
