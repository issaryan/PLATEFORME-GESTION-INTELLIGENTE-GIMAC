{
  "annotations": {
    "changelogDate": "20260930053918"
  },
  "applications": ["collaboration"],
  "clientRootFolder": "collaboration",
  "databaseType": "sql",
  "documentation": "Archive scellée d'un salon (algorithme 6.63) : PDF/A-3 horodaté RFC 3161,\\ndéposé en WORM 10 ans dans MS-DOCUMENT (RG-53, D-11). Écart CC corrigé :\\nCrisisArchive devient RoomArchive, D-28 étendant l'archivage aux salons\\nliés à un ticket.",
  "dto": "mapstruct",
  "fields": [
    {
      "fieldName": "id",
      "fieldType": "UUID"
    },
    {
      "documentation": "Cellule de crise (MS-INCIDENT), par exemple CRI-2026-009 ; vide pour un salon d'incident.",
      "fieldName": "crisisCellReference",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "50"
    },
    {
      "documentation": "Ticket lié (MS-INCIDENT).",
      "fieldName": "ticketReference",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "50"
    },
    {
      "fieldName": "messageCount",
      "fieldType": "Integer",
      "fieldValidateRules": ["required", "min"],
      "fieldValidateRulesMin": "0"
    },
    {
      "documentation": "Messages que le terminal d'archivage n'a pu déchiffrer, consignés comme tels.",
      "fieldName": "undecryptableCount",
      "fieldType": "Integer",
      "fieldValidateRules": ["required", "min"],
      "fieldValidateRulesMin": "0"
    },
    {
      "documentation": "Suites de chiffres masquées en 6+4 (RG-52).",
      "fieldName": "maskedSequences",
      "fieldType": "Integer",
      "fieldValidateRules": ["required", "min"],
      "fieldValidateRulesMin": "0"
    },
    {
      "documentation": "Tête de chaîne hM des entrées, portée au manifeste (formule 6.78).",
      "fieldName": "chainHead",
      "fieldType": "String",
      "fieldValidateRules": ["minlength", "maxlength", "pattern"],
      "fieldValidateRulesMaxlength": "64",
      "fieldValidateRulesMinlength": "64",
      "fieldValidateRulesPattern": "^[0-9a-f]{64}$"
    },
    {
      "documentation": "H = SHA256(document).",
      "fieldName": "contentDigest",
      "fieldType": "String",
      "fieldValidateRules": ["minlength", "maxlength", "pattern"],
      "fieldValidateRulesMaxlength": "64",
      "fieldValidateRulesMinlength": "64",
      "fieldValidateRulesPattern": "^[0-9a-f]{64}$"
    },
    {
      "documentation": "Jeton RFC 3161 encodé en DER.",
      "fieldName": "timestampToken",
      "fieldType": "Blob"
    },
    {
      "documentation": "Archive déposée : identifiant du document dans MS-DOCUMENT.",
      "fieldName": "documentRef",
      "fieldType": "UUID"
    },
    {
      "documentation": "Rétention de l'archive, en années ; 10 pour une archive de crise.",
      "fieldName": "retentionYears",
      "fieldType": "Integer",
      "fieldValidateRules": ["required", "min", "max"],
      "fieldValidateRulesMax": "99",
      "fieldValidateRulesMin": "1"
    },
    {
      "fieldName": "state",
      "fieldType": "ArchiveState",
      "fieldTypeDocumentation": "État de l'archive. Écart CC corrigé : l'algorithme 6.63 (étape 5) laisse\\nl'archive « en attente » si l'autorité d'horodatage est indisponible.",
      "fieldValidateRules": ["required"],
      "fieldValues": "EN_CONSTITUTION,EN_ATTENTE_HORODATAGE,SCELLEE"
    },
    {
      "fieldName": "startedAt",
      "fieldType": "Instant",
      "fieldValidateRules": ["required"]
    },
    {
      "fieldName": "sealedAt",
      "fieldType": "Instant"
    }
  ],
  "jpaMetamodelFiltering": true,
  "microserviceName": "collaboration",
  "name": "RoomArchive",
  "pagination": "pagination",
  "readOnly": true,
  "relationships": [
    {
      "documentation": "Une archive au plus par salon (idempotence de l'algorithme 6.63).",
      "otherEntityField": "code",
      "otherEntityName": "room",
      "relationshipName": "room",
      "relationshipSide": "left",
      "relationshipType": "one-to-one",
      "relationshipValidateRules": "required"
    }
  ],
  "searchEngine": "no",
  "service": "serviceClass"
}
