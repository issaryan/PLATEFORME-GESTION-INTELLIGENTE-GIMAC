  "documentation": "Terminal enrôlé et son état de vérification (signature croisée par la clé\\nmaîtresse). Seules les parties publiques sont connues ; le lot de pré-clés\\nà usage unique est détenu par le serveur de clés de Matrix Synapse.",
  "dto": "mapstruct",
  "fields": [
    {
      "fieldName": "id",
      "fieldType": "UUID"
    },
    {
      "documentation": "Propriétaire (MS-IAM), ou compte technique du terminal d'archivage.",
      "fieldName": "userId",
      "fieldType": "UUID",
      "fieldValidateRules": ["required"]
    },
    {
      "documentation": "Identifiant du terminal (device Matrix), par exemple TRM-7A21.",
      "fieldName": "terminalId",
      "fieldType": "String",
      "fieldValidateRules": ["required", "unique", "maxlength"],
      "fieldValidateRulesMaxlength": "100"
    },
    {
