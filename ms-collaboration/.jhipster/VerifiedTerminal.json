      "fieldType": "String",
      "fieldValidateRules": ["required", "minlength", "maxlength", "pattern"],
      "fieldValidateRulesMaxlength": "128",
      "fieldValidateRulesMinlength": "128",
      "fieldValidateRulesPattern": "^[0-9a-f]{128}$"
    },
    {
