      "fieldName": "identityKey",
      "fieldType": "String",
      "fieldValidateRules": ["required", "minlength", "maxlength", "pattern"],
      "fieldValidateRulesMaxlength": "64",
      "fieldValidateRulesMinlength": "64",
      "fieldValidateRulesPattern": "^[0-9a-f]{64}$"
    },
    {
      "documentation": "Clé d'accord publique X25519.",
      "fieldName": "agreementKey",
      "fieldType": "String",
      "fieldValidateRules": ["required", "minlength", "maxlength", "pattern"],
      "fieldValidateRulesMaxlength": "64",
      "fieldValidateRulesMinlength": "64",
      "fieldValidateRulesPattern": "^[0-9a-f]{64}$"
    },
    {
      "documentation": "Pré-clé signée publique.",
      "fieldName": "signedPreKey",
      "fieldType": "String",
      "fieldValidateRules": ["required", "minlength", "maxlength", "pattern"],
      "fieldValidateRulesMaxlength": "64",
      "fieldValidateRulesMinlength": "64",
      "fieldValidateRulesPattern": "^[0-9a-f]{64}$"
    },
    {
      "documentation": "Signature Ed25519 de la pré-clé signée par la clé d'identité (64 octets).",
