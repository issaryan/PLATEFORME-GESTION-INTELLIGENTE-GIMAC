      "fieldType": "Integer",
      "fieldValidateRules": ["required", "min"],
      "fieldValidateRulesMin": "0"
    },
    {
      "documentation": "Signature croisée par la clé maîtresse de l'utilisateur (64 octets).",
      "fieldName": "crossSignature",
      "fieldType": "String",
      "fieldValidateRules": ["minlength", "maxlength", "pattern"],
      "fieldValidateRulesMaxlength": "128",
      "fieldValidateRulesMinlength": "128",
      "fieldValidateRulesPattern": "^[0-9a-f]{128}$"
    },
    {
      "fieldName": "state",
