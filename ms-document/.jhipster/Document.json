      "fieldName": "maskingCandidates",
      "fieldType": "Integer",
      "fieldValidateRules": ["min"],
      "fieldValidateRulesMin": "0"
    },
    {
      "fieldName": "maskingLuhnValid",
      "fieldType": "Integer",
      "fieldValidateRules": ["min"],
      "fieldValidateRulesMin": "0"
    },
    {
      "fieldName": "maskingMasked",
      "fieldType": "Integer",
      "fieldValidateRules": ["min"],
      "fieldValidateRulesMin": "0"
    },
    {
      "fieldName": "maskingRejected",
      "fieldType": "Boolean"
    },
    {
      "documentation": "Déclaration PDF/A-3 vérifiée, pour une pièce générée.",
      "fieldName": "pdfaCompliant",
      "fieldType": "Boolean"
    },
    {
      "documentation": "Motif de rejet, sans détail sur la signature détectée.",
      "fieldName": "rejectionReason",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "500"
    },
    {
      "fieldName": "sealedAt",
      "fieldType": "Instant"
    },
    {
      "fieldName": "purgedAt",
      "fieldType": "Instant"
    }
  ],
